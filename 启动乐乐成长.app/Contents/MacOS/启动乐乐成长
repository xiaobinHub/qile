#!/bin/zsh
# Operate the independent production release; never run development server.py.
set -eu
APP_BIN_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(cd -- "$APP_BIN_DIR/../../.." && pwd)"
if [[ -f "$PROJECT_ROOT/control.py" && -f "$PROJECT_ROOT/current.json" ]]; then
  PRODUCTION_ROOT="$PROJECT_ROOT"
else
  PRODUCTION_ROOT="${PROJECT_ROOT:h}/乐乐成长-生产"
fi
if [[ ! -x "$PRODUCTION_ROOT/.venv/bin/python" || ! -f "$PRODUCTION_ROOT/control.py" ]]; then
  /usr/bin/osascript -e 'display alert "无法操作乐乐成长正式服务" message "未找到独立生产目录，请先完成生产环境安装。" as critical'
  exit 1
fi
ERROR_FILE="$(/usr/bin/mktemp)"
trap '/bin/rm -f "$ERROR_FILE"' EXIT
if ! "$PRODUCTION_ROOT/.venv/bin/python" "$PRODUCTION_ROOT/control.py" start --open >"$ERROR_FILE" 2>&1; then
  /usr/bin/osascript - "$(/bin/cat "$ERROR_FILE")" <<'APPLESCRIPT'
on run argv
  display alert "无法操作乐乐成长正式服务" message (item 1 of argv) as critical
end run
APPLESCRIPT
  exit 1
fi
