{
  "name": "lele-growth",
  "private": true,
  "scripts": {
    "test:browser": "node tests/browser/unified_browser_smoke.cjs",
    "check:admin": "tsc --project frontend/admin/tsconfig.json --noEmit",
    "build:admin": "npm run check:admin && vite build --config frontend/admin/vite.config.mts",
    "check:parent": "tsc --project frontend/parent/tsconfig.json --noEmit",
    "build:parent": "npm run check:parent && vite build --config frontend/parent/vite.config.mts",
    "test:domain": "node tests/domain/domain_tests.cjs && node tests/domain/runtime_tests.cjs",
    "check:format": "prettier --check frontend/parent/src frontend/shared/src",
    "check:typography": "node scripts/check_typography.cjs",
    "build": "npm run build:admin && npm run build:parent",
    "check:layout": "node scripts/check_layout.cjs",
    "test:backend": ".venv/bin/python scripts/dev.py test",
    "package:release": ".venv/bin/python scripts/package_release.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.61.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "9.13.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  }
}
