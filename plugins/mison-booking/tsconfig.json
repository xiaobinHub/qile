{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../../frontend/shared/src/*"],
      "@plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    }
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "../../packages/plugin-sdk/src/index.ts"]
}
